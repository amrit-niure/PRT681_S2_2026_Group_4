# Copy to .env and fill in. Used by docker-compose.yml.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Resend SMTP relay: the password is your Resend API key, the From address must be on a
# domain verified in Resend (onboarding@resend.dev works for testing to your own address).
Smtp__Host=smtp.resend.com
Smtp__Port=465
Smtp__User=resend
Smtp__Password=
Smtp__FromAddress=onboarding@resend.dev
Smtp__Security=SslOnConnect

# Optional: leave empty to disable Exceptionless.
Exceptionless__ApiKey=
